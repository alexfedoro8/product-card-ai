# Скопируйте этот файл в .env и укажите ключ ОДНОГО провайдера.
# Провайдер выбирается автоматически по заданному ключу.
# Если задано несколько, приоритет: OpenRouter → OpenAI → DeepSeek → Anthropic.

OPENROUTER_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=

# Необязательно:
# LLM_PROVIDER=openrouter          # явный выбор: openrouter | openai | deepseek | anthropic
# LLM_MODEL=openai/gpt-4o-mini     # модель; по умолчанию своя для каждого провайдера
# LLM_BASE_URL=                    # свой адрес OpenAI-совместимого API (прокси, локальная модель)
# LLM_TEMPERATURE=0.3
# LLM_TIMEOUT=60                   # секунд на один запрос к модели
# LLM_MAX_ATTEMPTS=3               # попыток генерации, если ответ не прошёл проверку

# Локальная модель через Ollama (OpenAI-совместимый API):
# LLM_PROVIDER=openai
# OPENAI_API_KEY=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:7b
